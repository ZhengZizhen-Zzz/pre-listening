# Optional: leave keys blank to explore the built-in demonstration.
# Model access and pricing depend on your provider account.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
ASR_MODEL=fun-asr
PORT=3210
# Workflow quota per server process; not a currency budget or raw API-call count.
MAX_PAID_REQUESTS=30
# Optional: full path to LibreOffice soffice. Common macOS/Linux paths are detected.
SOFFICE_PATH=
# Optional: Python with macOS Vision dependencies for image-only slide text.
OCR_PYTHON=
# Optional: Python 3 for extracting notes after legacy PPT conversion.
PPT_NOTES_PYTHON=
